<div style="padding:var(--spacing-16) 0 var(--spacing-24)">
  <div class="container" style="max-width:800px">
    <h1 style="font-family:var(--font-heading);font-size:clamp(2rem,4vw,3.5rem);font-weight:500;color:var(--color-navy);margin-bottom:var(--spacing-8);line-height:1.1">{{ page.title }}</h1>
    <div style="font-size:var(--text-md);line-height:1.8;color:var(--color-mid-gray)">
      {{ page.content }}
    </div>
  </div>
</div>
