<section class="collection-hero">
  <div class="container">
    <h1 class="collection-hero__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="collection-hero__description">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</section>

<div class="section-padding">
  <div class="container">
    <div class="collection-toolbar">
      <span class="collection-count">{{ collection.products_count }} styles</span>
      <div class="collection-sort">
        <label for="sort-by" style="font-size:var(--text-sm);color:var(--color-mid-gray);font-weight:500">Sort:</label>
        <select id="sort-by" name="sort_by">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"
              {%- if option.value == collection.sort_by %} selected="selected"{% endif %}>
              {{ option.name }}
            </option>
          {%- endfor -%}
        </select>
      </div>
    </div>

    <div class="product-grid">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p style="grid-column:1/-1;text-align:center;color:var(--color-mid-gray);padding:var(--spacing-16)">
          No products found in this collection.
        </p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="pagination__item" aria-label="Previous page">&larr;</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="pagination__item">{{ part.title }}</a>
          {%- else -%}
            <span class="pagination__item{% if part.title == paginate.current_page %} is-active{% endif %}">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="pagination__item" aria-label="Next page">&rarr;</a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  </div>
</div>
