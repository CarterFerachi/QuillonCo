[
  {
    "name": "theme_info",
    "theme_name": "QuillonCo",
    "theme_version": "1.0.0",
    "theme_author": "QuillonCo",
    "theme_documentation_url": "https://github.com/carterferachi/quillonco",
    "theme_support_url": "https://github.com/carterferachi/quillonco/issues"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface (cards, panels)",
        "default": "#F6F5F2"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#16181D"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (navy)",
        "default": "#1B2A4A"
      },
      {
        "type": "color",
        "id": "color_accent_2",
        "label": "Secondary accent (forest)",
        "default": "#22402F"
      },
      {
        "type": "color",
        "id": "color_button",
        "label": "Button background",
        "default": "#16181D"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Button text",
        "default": "#FFFFFF"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "assistant_n7"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1200,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Page width",
        "default": 1440
      },
      {
        "type": "range",
        "id": "card_corner_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Card corner radius",
        "default": 4
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "Button corner radius",
        "default": 2
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "Show vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_secondary_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_enable_quick_add",
        "label": "Enable quick add",
        "default": true
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      },
      {
        "type": "text",
        "id": "cart_free_shipping_threshold",
        "label": "Free shipping threshold",
        "info": "Amount in your store currency (numbers only, e.g. 150). Leave blank to hide the progress bar.",
        "default": "150"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/quillonco"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "X (Twitter)"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok"
      },
      {
        "type": "text",
        "id": "social_linkedin_link",
        "label": "LinkedIn"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  }
]
