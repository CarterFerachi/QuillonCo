{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>{{ 'Gift card' }} &ndash; {{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <style>
      body { padding: 4rem var(--page-gutter, 2rem); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
      .gift-card { max-width: 56rem; margin: 0 auto; text-align: center; }
      .gift-card__code { font-size: 2rem; letter-spacing: 0.2em; padding: 1.6rem 2.4rem; border: 1px dashed #999; border-radius: 6px; display: inline-block; margin: 2.4rem 0; }
      .gift-card__amount { font-size: 3.2rem; font-weight: 700; margin-top: 1.6rem; }
    </style>
  </head>
  <body>
    <div class="gift-card">
      <h1>{{ shop.name }}</h1>
      <p class="gift-card__amount">{{ gift_card.initial_value | money }}</p>
      {% if gift_card.enabled == false or gift_card.expired %}
        <p>This gift card has expired.</p>
      {% endif %}
      <p class="gift-card__code">{{ gift_card.code | format_code }}</p>
      <p>
        <a href="{{ shop.url }}">Use this code at checkout &rarr;</a>
      </p>
    </div>
  </body>
</html>
