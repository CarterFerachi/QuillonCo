{%- comment -%}
  Renders a product or variant price.
  Accepts:
  - product: {Object} Product object (optional)
  - use_variant: {Boolean} Render selected/first available variant price instead of product range
  - price_class: {String} Extra classes
{%- endcomment -%}
{%- liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
  else
    assign target = product
  endif

  assign money_price = target.price | money
  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999

  if product.price_varies and use_variant != true
    assign money_price = 'products.product.price.from_price_html' | t: price: money_price
  endif
-%}

<div class="price {{ price_class }}">
  {%- if compare_at_price > price -%}
    <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
    <span class="price__sale">{{ money_price }}</span>
    <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
    <s class="price__compare">{{ compare_at_price | money }}</s>
  {%- else -%}
    <span>{{ money_price }}</span>
  {%- endif -%}
  {%- if target.unit_price_measurement -%}
    <span class="price__unit">
      {{ target.unit_price | money }}
      <span aria-hidden="true">/</span>
      <span class="visually-hidden">{{ 'general.accessibility.unit_price_separator' | t }}</span>
      {%- if target.unit_price_measurement.reference_value != 1 -%}
        {{- target.unit_price_measurement.reference_value -}}
      {%- endif -%}
      {{ target.unit_price_measurement.reference_unit }}
    </span>
  {%- endif -%}
</div>
