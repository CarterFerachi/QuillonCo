<drawer-element id="SearchDrawer" class="drawer search-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel search-drawer__panel">
    <div class="drawer__body">
      <predictive-search>
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-drawer__form">
          <input type="hidden" name="type" value="product">
          <input type="hidden" name="options[prefix]" value="last">
          <input
            class="search-drawer__input"
            type="search"
            name="q"
            placeholder="{{ 'general.search.placeholder' | t }}"
            aria-label="{{ 'general.search.search' | t }}"
            autocomplete="off"
            data-drawer-focus
          >
          <button type="submit" class="header__icon" aria-label="{{ 'general.search.search' | t }}">
            {% render 'icon', icon: 'search' %}
          </button>
          <button class="drawer__close" type="button" data-drawer-close aria-label="{{ 'general.accessibility.close' | t }}">
            {% render 'icon', icon: 'close' %}
          </button>
        </form>
        <div class="predictive-search" data-predictive-results aria-live="polite"></div>
      </predictive-search>
    </div>
  </div>
</drawer-element>
