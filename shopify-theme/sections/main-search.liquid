<section class="section">
  <div class="page-width">
    <div class="search-page__header">
      <h1 class="h1">{{ 'templates.search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
        <input type="hidden" name="options[prefix]" value="last">
        <div class="field">
          <input
            class="field__input"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.placeholder' | t }}"
            aria-label="{{ 'general.search.search' | t }}"
          >
        </div>
        <button type="submit" class="button">{{ 'general.search.search' | t }}</button>
      </form>
      {%- if search.performed -%}
        <p class="lead" style="margin-top: 2.4rem;">
          {%- if search.results_count == 0 -%}
            {{ 'templates.search.no_results' | t: terms: search.terms }}
          {%- else -%}
            {{ 'general.search.results_with_count' | t: count: search.results_count, terms: search.terms }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

    {%- if search.performed and search.results_count > 0 -%}
      {%- paginate search.results by 16 -%}
        <ul class="product-grid product-grid--4" role="list" style="margin-top: 5rem;">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', card_product: item %}
            {%- else -%}
              <li class="card">
                <div class="card__content">
                  <span class="card__vendor">{{ item.object_type | capitalize }}</span>
                  <h3 class="card__title"><a href="{{ item.url }}">{{ item.title | escape }}</a></h3>
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search results",
  "settings": []
}
{% endschema %}
