<section class="section section--flush" style="padding-bottom: var(--section-spacing);">
  <div class="page-width">
    <div class="section-header section-header--center" style="padding-top: var(--section-spacing);">
      <div class="section-header__text">
        {%- if section.settings.handle != blank -%}
          <span class="eyebrow eyebrow--accent scroll-trigger">{{ section.settings.handle | escape }}</span>
        {%- endif -%}
        <h2 class="h2 scroll-trigger" data-cascade="1">{{ section.settings.heading | escape }}</h2>
      </div>
    </div>
  </div>

  <div class="social-gallery">
    {%- for block in section.blocks -%}
      {%- liquid
        assign fallback = 'life-club'
        assign fallback_index = forloop.index0 | modulo: 6
        case fallback_index
          when 1
            assign fallback = 'product-navy'
          when 2
            assign fallback = 'life-tennis'
          when 3
            assign fallback = 'life-dinner'
          when 4
            assign fallback = 'product-green'
          when 5
            assign fallback = 'life-travel'
        endcase
        assign link = block.settings.link | default: settings.social_instagram_link
      -%}
      <a
        href="{{ link | default: '#' }}"
        class="social-gallery__item"
        {% if link != blank %}target="_blank" rel="noopener" aria-describedby="a11y-new-window-message"{% endif %}
        {{ block.shopify_attributes }}
      >
        <div class="media">
          {%- if block.settings.image != blank -%}
            <img
              srcset="{{ block.settings.image | image_url: width: 360 }} 360w,
                {{ block.settings.image | image_url: width: 540 }} 540w,
                {{ block.settings.image | image_url: width: 720 }} 720w"
              src="{{ block.settings.image | image_url: width: 540 }}"
              sizes="(min-width: 750px) 17vw, 33vw"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {%- else -%}
            {% render 'demo-image', name: fallback, alt: '' %}
          {%- endif -%}
        </div>
        <span class="social-gallery__icon">{% render 'icon', icon: 'instagram' %}</span>
        <span class="visually-hidden">Instagram</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Social gallery",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "default": "@quillonco"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In the Wild"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Square, 720 x 720px recommended"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Defaults to your Instagram profile from theme settings"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
