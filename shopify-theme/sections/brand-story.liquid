<section class="brand-story">
  <div class="brand-story__grid container--wide" style="max-width: 1440px; margin: 0 auto;">
    <div class="brand-story__media">
      {%- if section.settings.image != blank -%}
        <img class="brand-story__image" src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy">
      {%- else -%}
        <img class="brand-story__image" src="https://d8j0ntlcm91z4.cloudfront.net/user_3FVcuBaoBTkgMgDv4hAHDXGVk6V/hf_20260630_233809_257d39fb-75c5-4724-bccf-f1d588241b5b.png" alt="The QuillonCo Standard" loading="lazy">
      {%- endif -%}
    </div>
    <div class="brand-story__content">
      <div class="brand-story__inner">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="brand-story__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.body != blank -%}
          <p class="brand-story__body">{{ section.settings.body }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_url }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
        {%- endif -%}
        <div class="brand-story__stats">
          <div class="stat-item">
            <div class="stat-item__number">4<em>&times;</em></div>
            <div class="stat-item__label">Stretch All Directions</div>
          </div>
          <div class="stat-item">
            <div class="stat-item__number">48<em>h</em></div>
            <div class="stat-item__label">Anti-Odor Protection</div>
          </div>
          <div class="stat-item">
            <div class="stat-item__number">100<em>%</em></div>
            <div class="stat-item__label">Satisfaction Guaranteed</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Standard" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The QuillonCo Standard" },
    { "type": "textarea", "id": "body", "label": "Body Text", "default": "Engineered in the South. Built for Everywhere." },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "Our Story" },
    { "type": "url", "id": "button_url", "label": "Button URL" }
  ],
  "presets": [{ "name": "Brand Story" }]
}
{% endschema %}
