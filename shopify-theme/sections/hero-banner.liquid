{%- liquid
  assign height_class = 'hero--large'
  if section.settings.height == 'full'
    assign height_class = 'hero--full'
  elsif section.settings.height == 'medium'
    assign height_class = 'hero--medium'
  endif
-%}

<section class="hero {{ height_class }}">
  <parallax-media class="hero__media hero__media--parallax">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag: autoplay: true, loop: true, muted: true, controls: false, preload: 'metadata', image_size: '1600x'
      }}
    {%- elsif section.settings.image != blank -%}
      <img
        srcset="{{ section.settings.image | image_url: width: 750 }} 750w,
          {{ section.settings.image | image_url: width: 1100 }} 1100w,
          {{ section.settings.image | image_url: width: 1500 }} 1500w,
          {{ section.settings.image | image_url: width: 1920 }} 1920w,
          {{ section.settings.image | image_url: width: 2560 }} 2560w"
        src="{{ section.settings.image | image_url: width: 1920 }}"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        fetchpriority="high"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    {%- else -%}
      {% render 'demo-image', name: 'hero', alt: section.settings.heading, loading: 'eager' %}
    {%- endif -%}
  </parallax-media>
  <div class="hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

  <div class="hero__content page-width">
    <div class="hero__box hero__box--{{ section.settings.content_position }}">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow eyebrow--inverse scroll-trigger">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 class="hero__heading scroll-trigger" data-cascade="1">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="hero__text scroll-trigger" data-cascade="2">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
        <div class="hero__buttons scroll-trigger" data-cascade="3">
          {%- if section.settings.button_label != blank -%}
            <a href="{{ section.settings.button_link }}" class="button button--inverse">{{ section.settings.button_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a href="{{ section.settings.button_link_2 }}" class="button button--outline-inverse">{{ section.settings.button_label_2 | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_scroll_hint and section.settings.height == 'full' -%}
    <div class="hero__scroll-hint" aria-hidden="true">
      <span>Scroll</span>
      {% render 'icon', icon: 'chevron-down' %}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "2560 x 1440px recommended. A bundled campaign image is used until you pick one."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (optional)",
      "info": "Overrides the image. Plays muted on loop."
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 100
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Performance Polo, Perfected"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Performance Without Compromise."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Premium performance polos engineered for the course, the office and everywhere in between."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Polos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label",
      "default": "Explore the Collection"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_hint",
      "label": "Show scroll hint",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
