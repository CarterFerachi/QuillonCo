<footer class="footer">
  {%- if section.settings.show_newsletter -%}
    <div class="footer__newsletter-band">
      <div class="page-width footer__newsletter-inner">
        <div>
          <h2 class="h3">{{ section.settings.newsletter_heading }}</h2>
          <p class="footer__brand-text" style="margin-top: 0.8rem;">{{ section.settings.newsletter_text }}</p>
        </div>
        {%- form 'customer', class: 'newsletter__form', id: 'FooterNewsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="field">
            <input
              id="FooterNewsletter-email"
              type="email"
              name="contact[email]"
              class="field__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ 'newsletter.label' | t }}"
              required
            >
            <label class="visually-hidden" for="FooterNewsletter-email">{{ 'newsletter.label' | t }}</label>
          </div>
          <button type="submit" class="button button--inverse" name="commit">{{ 'newsletter.button_label' | t }}</button>
          {%- if form.posted_successfully? -%}
            <p class="form__message" style="color: #7fd1a0;" role="status">{{ 'newsletter.success' | t }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  {%- endif -%}

  <div class="page-width">
    <div class="footer__main">
      <div>
        <p class="footer__brand-title">Quillon<span style="color: rgba(255,255,255,0.55);">Co</span></p>
        <p class="footer__brand-text">{{ section.settings.brand_text }}</p>
        <div class="footer__social">
          {%- assign social_icons = 'instagram,facebook,twitter,youtube,tiktok,linkedin' | split: ',' -%}
          {%- for icon in social_icons -%}
            {%- assign setting_key = 'social_' | append: icon | append: '_link' -%}
            {%- assign url = settings[setting_key] -%}
            {%- if url != blank -%}
              {%- assign label_key = 'general.social.links.' | append: icon -%}
              <a class="footer__social-link" href="{{ url }}" target="_blank" rel="noopener" aria-describedby="a11y-new-window-message" aria-label="{{ label_key | t }}">
                {% render 'icon', icon: icon %}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h3 class="footer__block-heading">{{ block.settings.heading | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.menu != blank -%}
            <ul class="footer__menu" role="list">
              {%- for link in block.settings.menu.links -%}
                <li><a class="footer__menu-link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <ul class="footer__policies" role="list">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if section.settings.show_payment_icons -%}
        <div class="footer__payment" aria-label="{{ 'sections.footer.payment' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
      <small>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</small>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "textarea",
      "id": "brand_text",
      "label": "Brand statement",
      "default": "Premium performance polos engineered for the course, the office and everywhere in between. Confidence, worn daily."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter band",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Join the club"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "New drops, member offers and stories from the course — straight to your inbox."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [{ "type": "link_list" }]
    }
  ]
}
{% endschema %}
