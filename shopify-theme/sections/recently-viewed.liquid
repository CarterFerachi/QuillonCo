<section class="section">
  <div class="page-width">
    <recently-viewed data-exclude="{{ product.handle }}" data-limit="{{ section.settings.products_to_show }}">
      <div class="section-header">
        <div class="section-header__text">
          <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        </div>
      </div>
      <ul class="product-grid product-grid--4" role="list" data-recently-viewed-grid></ul>
    </recently-viewed>
  </div>
</section>

{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    }
  ]
}
{% endschema %}
