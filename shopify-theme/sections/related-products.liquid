<product-recommendations
  class="section section--surface"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}"
  style="display: block;"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="section-header">
        <div class="section-header__text">
          <h2 class="h2 scroll-trigger">{{ section.settings.heading | escape }}</h2>
        </div>
      </div>
      <ul class="product-grid product-grid--4" role="list">
        {%- for recommended in recommendations.products limit: section.settings.products_to_show -%}
          {%- assign cascade = forloop.index | at_most: 4 -%}
          {% render 'product-card', card_product: recommended, cascade: cascade %}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Related products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    }
  ]
}
{% endschema %}
