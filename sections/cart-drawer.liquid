{%- comment -%}
  Cart drawer. Re-rendered via the Section Rendering API by requesting
  /?sections=cart-drawer — see CartAPI.refreshDrawer() in global.js.
{%- endcomment -%}
<drawer-element id="CartDrawer" class="drawer cart-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'sections.cart.title' | t }}">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel">
    <div id="CartDrawerContent" class="drawer__panel-inner" style="display: flex; flex-direction: column; height: 100%;">
      <div class="drawer__header">
        <h2 class="drawer__title">
          {{ 'sections.cart.title' | t }}
          <span data-cart-count-inline>({{ cart.item_count }})</span>
        </h2>
        <button class="drawer__close" type="button" data-drawer-close aria-label="{{ 'general.accessibility.close' | t }}">
          {% render 'icon', icon: 'close' %}
        </button>
      </div>

      {%- if cart.item_count > 0 -%}
        <div class="drawer__body">
          {%- assign threshold_raw = settings.cart_free_shipping_threshold | strip -%}
          {%- if threshold_raw != blank -%}
            {%- assign threshold_cents = threshold_raw | times: 100 -%}
            {%- if threshold_cents > 0 -%}
              {%- assign remaining = threshold_cents | minus: cart.total_price -%}
              <div class="shipping-meter">
                {%- if remaining > 0 -%}
                  {%- assign remaining_money = remaining | money -%}
                  <p class="shipping-meter__text">{{ 'sections.cart.free_shipping_progress' | t: amount: remaining_money }}</p>
                  {%- assign progress = cart.total_price | times: 100 | divided_by: threshold_cents -%}
                {%- else -%}
                  <p class="shipping-meter__text"><strong>{{ 'sections.cart.free_shipping_unlocked' | t }}</strong></p>
                  {%- assign progress = 100 -%}
                {%- endif -%}
                <div class="shipping-meter__bar" role="progressbar" aria-valuenow="{{ progress | at_most: 100 }}" aria-valuemin="0" aria-valuemax="100">
                  <div class="shipping-meter__progress" style="width: {{ progress | at_most: 100 }}%;"></div>
                </div>
              </div>
            {%- endif -%}
          {%- endif -%}

          <cart-items role="list" aria-label="{{ 'sections.cart.caption' | t }}">
            {%- for item in cart.items -%}
              <div class="cart-item" role="listitem">
                <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
                  <div class="media media--portrait">
                    {%- if item.image -%}
                      <img
                        src="{{ item.image | image_url: width: 240 }}"
                        alt="{{ item.image.alt | escape }}"
                        loading="lazy"
                        width="120"
                        height="150"
                      >
                    {%- endif -%}
                  </div>
                </a>
                <div class="cart-item__details">
                  <a class="cart-item__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                  {%- unless item.product.has_only_default_variant -%}
                    <span class="cart-item__options">
                      {%- for option in item.options_with_values -%}
                        {{ option.value }}{% unless forloop.last %} / {% endunless %}
                      {%- endfor -%}
                    </span>
                  {%- endunless -%}
                  {%- for discount in item.line_level_discount_allocations -%}
                    <span class="cart-item__options">{{ discount.discount_application.title }}</span>
                  {%- endfor -%}
                  <span class="cart-item__price">{{ item.final_line_price | money }}</span>
                  <div class="cart-item__controls">
                    <quantity-input class="quantity">
                      <button type="button" name="minus" aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}">
                        {% render 'icon', icon: 'minus' %}
                      </button>
                      <input
                        class="quantity__input"
                        type="number"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        min="0"
                        data-line-quantity
                        data-line="{{ forloop.index }}"
                        aria-label="{{ 'products.product.quantity.label' | t }}"
                      >
                      <button type="button" name="plus" aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}">
                        {% render 'icon', icon: 'plus' %}
                      </button>
                    </quantity-input>
                    <button type="button" class="cart-item__remove" data-cart-remove data-line="{{ forloop.index }}" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}">
                      {{ 'sections.cart.remove' | t }}
                    </button>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </cart-items>
        </div>

        <div class="drawer__footer">
          <div class="cart-drawer__subtotal">
            <span>{{ 'sections.cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <p class="cart-drawer__caption">{{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}</p>
          <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm">
            <button type="submit" name="checkout" class="button button--full" form="CartDrawerForm">
              {{ 'sections.cart.checkout' | t }}
            </button>
          </form>
        </div>
      {%- else -%}
        <div class="cart-drawer__empty">
          <h3 class="h3">{{ 'sections.cart.empty' | t }}</h3>
          <a href="{{ routes.all_products_collection_url }}" class="button" data-drawer-close>
            {{ 'sections.cart.start_shopping' | t }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</drawer-element>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
