<section class="brand-story" style="padding:0">
  <div class="brand-story__grid{% if section.settings.image_position == 'right' %} brand-story__grid--reversed{% endif %}">
    <div class="brand-story__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt | default: 'Brand story' }}" class="brand-story__image" loading="lazy">
      {%- else -%}
        <div class="brand-story__media--placeholder"></div>
      {%- endif -%}
    </div>
    <div class="brand-story__content">
      <div class="brand-story__inner">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--dark brand-story__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="heading-lg brand-story__heading">{{ section.settings.heading }}</h2>
        <div class="brand-story__body">{{ section.settings.body }}</div>
        {%- if section.settings.btn_label != blank -%}<a href="{{ section.settings.btn_url }}" class="btn btn--primary">{{ section.settings.btn_label }}</a>{%- endif -%}
        {%- if section.settings.signature != blank -%}<div class="brand-story__signature">{{ section.settings.signature }}</div>{%- endif -%}
      </div>
    </div>
  </div>
</section>
<style>.brand-story__grid--reversed{direction:rtl}.brand-story__grid--reversed>*{direction:ltr}</style>
{% schema %}
{"name":"Brand Story","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"image_position","label":"Image position","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}],"default":"left"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The QuillonCo Standard"},{"type":"text","id":"heading","label":"Heading","default":"Engineered in the South. Built for Everywhere."},{"type":"richtext","id":"body","label":"Body","default":"<p>QuillonCo was built on one idea: that athletic performance and sharp style should never be a trade-off. Our collar shirts are precision-engineered with performance fabrics — moisture-wicking, four-way stretch, anti-odor — designed to perform as hard as you do.</p><p>Southern roots. Global standards. No compromises.</p>"},{"type":"text","id":"btn_label","label":"Button label","default":"Our Story"},{"type":"url","id":"btn_url","default":"/pages/about"},{"type":"text","id":"signature","label":"Signature","default":"— QuillonCo"}],"presets":[{"name":"Brand Story"}]}
{% endschema %}
