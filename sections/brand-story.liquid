<section class="brand-story section-padding" style="padding:0">
  <div class="brand-story__grid{% if section.settings.image_position == 'right' %} brand-story__grid--reversed{% endif %}">

    <div class="brand-story__media">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1000 }}"
          alt="{{ section.settings.image.alt | default: 'Brand story' }}"
          class="brand-story__image"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {%- else -%}
        <div class="brand-story__media--placeholder"></div>
      {%- endif -%}
    </div>

    <div class="brand-story__content">
      <div class="brand-story__inner">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow brand-story__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h2 class="heading-lg brand-story__heading">{{ section.settings.heading }}</h2>

        <div class="brand-story__body">
          {{ section.settings.body }}
        </div>

        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_url }}" class="btn btn--primary">{{ section.settings.btn_label }}</a>
        {%- endif -%}

        {%- if section.settings.signature != blank -%}
          <div class="brand-story__signature">{{ section.settings.signature }}</div>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

<style>
  .brand-story__grid--reversed { direction: rtl; }
  .brand-story__grid--reversed > * { direction: ltr; }
</style>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{"value": "left", "label": "Left"}, {"value": "right", "label": "Right"}], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Heritage" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Born on the Back Porch, Built for the Best" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>QuillonCo was born from a simple belief: that a man should dress as well on the golf course as he does at the dinner table. Our polo shirts marry the relaxed confidence of southern living with the clean lines of modern sportswear.</p><p>Every shirt is cut from premium pique cotton, finished with signature details, and designed to carry you from the first tee to the last glass with effortless ease.</p>" },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Discover Our Story" },
    { "type": "url", "id": "btn_url", "label": "Button link", "default": "/pages/about" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "— The QuillonCo Family" }
  ],
  "presets": [{ "name": "Brand Story", "category": "Content" }]
}
{% endschema %}
