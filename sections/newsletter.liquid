{%- form 'customer', id: 'newsletter-form' -%}
  <input type="hidden" name="contact[tags]" value="newsletter">
{%- endform -%}

<section class="newsletter">
  <div class="newsletter__inner">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow" style="display:block;margin-bottom:var(--spacing-3)">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2 class="heading-md newsletter__heading">{{ section.settings.heading }}</h2>
    <p class="newsletter__body">{{ section.settings.body }}</p>

    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter__form">
        <input
          type="email"
          name="contact[email]"
          class="newsletter__input"
          placeholder="{{ section.settings.placeholder | default: 'Your email address' }}"
          autocomplete="email"
          required
          aria-label="Email address"
        >
        <button type="submit" class="btn btn--primary">{{ section.settings.btn_label | default: 'Subscribe' }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p style="color:var(--color-green);font-size:var(--text-sm);margin-top:var(--spacing-3)">Thank you for subscribing. Welcome to the QuillonCo family.</p>
      {%- endif -%}
    {%- endform -%}

    <p class="newsletter__privacy">{{ section.settings.privacy_text }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the Club" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gentleman's Dispatch" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Subscribe for new arrivals, exclusive member offers, and stories from the South. No spam, ever." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "your@email.com" },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "privacy_text", "label": "Privacy note", "default": "We respect your privacy. Unsubscribe anytime." }
  ],
  "presets": [{ "name": "Newsletter", "category": "Email" }]
}
{% endschema %}
