<section class="newsletter">
  <div class="newsletter__inner">
    <span class="eyebrow">Stay In The Game</span>
    <h2 class="newsletter__heading">{{ section.settings.heading }}</h2>
    <p class="newsletter__body">{{ section.settings.body }}</p>
    {% form 'customer', class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input class="newsletter__input" type="email" name="contact[email]" placeholder="Your email address" aria-label="Email address" required>
      <button type="submit" class="btn btn--primary">Subscribe</button>
    {% endform %}
    <p class="newsletter__privacy">No spam. Unsubscribe anytime.</p>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "First to the Drop" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Get early access to new collections, training content, and exclusive offers — straight to your inbox." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}