<section class="section{% if section.settings.background == 'surface' %} section--surface{% endif %}">
  <div class="page-width">
    <div class="section-header">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow eyebrow--accent scroll-trigger">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="h2 scroll-trigger" data-cascade="1">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.description != blank -%}
          <p class="lead scroll-trigger" data-cascade="2">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all and section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="link-arrow scroll-trigger" data-cascade="2">
          {{ 'sections.featured_collection.view_all' | t }}
          {% render 'icon', icon: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    <ul class="product-grid product-grid--4" role="list">
      {%- assign products = section.settings.collection.products -%}
      {%- if products.size > 0 -%}
        {%- for product in products limit: section.settings.products_to_show -%}
          {%- assign cascade = forloop.index | at_most: 4 -%}
          {% render 'product-card', card_product: product, cascade: cascade %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          {% render 'product-card', card_product: blank, cascade: i %}
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Essentials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view-all link",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "surface", "label": "Soft surface" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
