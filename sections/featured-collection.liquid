{%- assign collection = collections[section.settings.collection] -%}

<section class="section-padding">
  <div class="container">
    <div class="section-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="heading-lg">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p>{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="product-grid">
      {%- if collection != blank -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="product-card">
            <div class="product-card__media">
              {{ 'product-' | append: i | placeholder_svg_tag: 'product-card__image' }}
            </div>
            <div class="product-card__info">
              <div class="product-card__vendor">QuillonCo</div>
              <div class="product-card__title">Classic Polo — Heritage Edition</div>
              <div class="product-card__price">$128.00</div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_btn -%}
      <div style="text-align:center;margin-top:3rem">
        <a href="{{ section.settings.btn_url | default: '/collections/all' }}" class="btn btn--secondary">
          {{ section.settings.btn_label | default: 'View All' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Refined for Every Occasion" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Polo shirts that move with you — from the golf course to the evening social." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "checkbox", "id": "show_btn", "label": "Show view all button", "default": true },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "View All Styles" },
    { "type": "url", "id": "btn_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Featured Collection", "category": "Collection" }]
}
{% endschema %}
