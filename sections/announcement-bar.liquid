<style>
  .announcement-bar { display: none; }
  {% if section.settings.show_bar %}.announcement-bar { display: flex; }{% endif %}
</style>

<div class="announcement-bar" role="region" aria-label="Announcement">
  <p>
    {{ section.settings.text }}
    {%- if section.settings.link != blank and section.settings.link_text != blank -%}
      &nbsp;<a href="{{ section.settings.link }}">{{ section.settings.link_text }}</a>
    {%- endif -%}
  </p>
</div>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    { "type": "checkbox", "id": "show_bar", "label": "Show bar", "default": true },
    { "type": "text", "id": "text", "label": "Message", "default": "Complimentary shipping on orders over $150 &nbsp;&middot;&nbsp; Crafted in the American South" },
    { "type": "text", "id": "link_text", "label": "Link text" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Announcement Bar" }]
}
{% endschema %}
