{%- comment -%}
  Renders a product card.
  Accepts:
  - card_product: {Object} Product object
  - lazy_load: {Boolean} Defaults to true
  - cascade: {Number} Optional stagger index for scroll reveal (1-6)
{%- endcomment -%}
{%- liquid
  assign lazy = lazy_load | default: true, allow_false: true
  assign show_secondary = settings.card_show_secondary_image
  assign quick_add_enabled = settings.card_enable_quick_add
-%}

{%- if card_product and card_product != empty -%}
  <li class="card scroll-trigger" {% if cascade %}data-cascade="{{ cascade }}"{% endif %}>
    <div class="card__media media-zoom-hover">
      <div class="card__badges">
        {%- if card_product.available == false -%}
          <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
        {%- elsif card_product.compare_at_price > card_product.price -%}
          <span class="badge badge--sale">{{ 'products.product.on_sale' | t }}</span>
        {%- endif -%}
      </div>

      <div class="media media--portrait">
        {%- if card_product.featured_media -%}
          <img
            srcset="{{ card_product.featured_media | image_url: width: 360 }} 360w,
              {{ card_product.featured_media | image_url: width: 540 }} 540w,
              {{ card_product.featured_media | image_url: width: 720 }} 720w,
              {{ card_product.featured_media | image_url: width: 940 }} 940w"
            src="{{ card_product.featured_media | image_url: width: 540 }}"
            sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw"
            alt="{{ card_product.featured_media.alt | default: card_product.title | escape }}"
            {% if lazy %}loading="lazy"{% else %}fetchpriority="high"{% endif %}
            width="{{ card_product.featured_media.width }}"
            height="{{ card_product.featured_media.height }}"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      {%- if show_secondary and card_product.media[1] -%}
        <div class="card__media-secondary media media--portrait" aria-hidden="true">
          <img
            src="{{ card_product.media[1] | image_url: width: 540 }}"
            srcset="{{ card_product.media[1] | image_url: width: 540 }} 540w,
              {{ card_product.media[1] | image_url: width: 940 }} 940w"
            sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw"
            alt=""
            loading="lazy"
            width="{{ card_product.media[1].width }}"
            height="{{ card_product.media[1].height }}"
          >
        </div>
      {%- endif -%}

      {%- if quick_add_enabled and card_product.available -%}
        <quick-add class="card__quick-add">
          <div class="quick-add__panel">
            {%- if card_product.variants.size == 1 -%}
              <button
                type="button"
                class="quick-add__button"
                data-variant-id="{{ card_product.first_available_variant.id }}"
                aria-label="{{ 'products.product.add_to_cart' | t }} — {{ card_product.title | escape }}"
              >
                {{ 'products.product.add_to_cart' | t }}
              </button>
            {%- else -%}
              {%- liquid
                assign size_option_index = -1
                for option in card_product.options_with_values
                  assign downcased = option.name | downcase
                  if downcased == 'size'
                    assign size_option_index = forloop.index0
                  endif
                endfor
              -%}
              {%- if size_option_index > -1 and card_product.options.size == 1 -%}
                <span class="quick-add__label">{{ 'products.product.quick_add' | t }} &mdash; {{ 'products.product.choose_size' | t }}</span>
                <div class="quick-add__options">
                  {%- for variant in card_product.variants -%}
                    <button
                      type="button"
                      class="quick-add__option"
                      data-variant-id="{{ variant.id }}"
                      {% unless variant.available %}disabled{% endunless %}
                      aria-label="{{ 'products.product.add_to_cart' | t }} — {{ card_product.title | escape }} {{ variant.title | escape }}"
                    >
                      {{ variant.options[size_option_index] }}
                    </button>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <a href="{{ card_product.url }}" class="quick-add__button">{{ 'products.product.view_full_details' | t }}</a>
              {%- endif -%}
            {%- endif -%}
          </div>
        </quick-add>
      {%- endif -%}
    </div>

    <div class="card__content">
      {%- if settings.card_show_vendor -%}
        <span class="card__vendor">{{ card_product.vendor }}</span>
      {%- endif -%}
      <h3 class="card__title">
        <a href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
      </h3>
      <div class="card__price">
        {% render 'price', product: card_product %}
      </div>
      {%- liquid
        assign color_option = blank
        for option in card_product.options_with_values
          assign downcased = option.name | downcase
          if downcased == 'color' or downcased == 'colour'
            assign color_option = option
          endif
        endfor
      -%}
      {%- if color_option != blank -%}
        <div class="card__swatches" aria-hidden="true">
          {%- for value in color_option.values limit: 5 -%}
            <span class="swatch" style="background-color: {{ value | handle | replace: '-', '' | default: value }};" title="{{ value | escape }}"></span>
          {%- endfor -%}
          {%- if color_option.values.size > 5 -%}
            <span class="card__swatch-more">+{{ color_option.values.size | minus: 5 }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </li>
{%- else -%}
  <li class="card scroll-trigger" {% if cascade %}data-cascade="{{ cascade }}"{% endif %}>
    <div class="card__media">
      <div class="media media--portrait">
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    </div>
    <div class="card__content">
      <h3 class="card__title"><a href="#">{{ 'onboarding.product_title' | t }}</a></h3>
      <div class="card__price"><span class="price">{{ 4900 | money }}</span></div>
    </div>
  </li>
{%- endif -%}
